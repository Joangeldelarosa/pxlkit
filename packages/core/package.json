{
  "name": "@pxlkit/core",
  "version": "1.4.0",
  "description": "Pixel art rendering engine for Pxlkit: framework-agnostic core (SVG renderer, animation player, 3D parallax) plus React components, utilities and types",
  "license": "MIT",
  "homepage": "https://pxlkit.xyz/docs",
  "bugs": {
    "url": "https://github.com/Joangeldelarosa/pxlkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joangeldelarosa/pxlkit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vanilla": [
        "./dist/vanilla.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "pixel-art",
    "icons",
    "svg",
    "react",
    "retro",
    "8bit",
    "16bit",
    "pxlkit",
    "pixel-art-icons",
    "react-icons",
    "svg-icons",
    "icon-library",
    "icon-renderer",
    "animated-icons",
    "parallax-3d",
    "toast-notifications",
    "tree-shakeable",
    "typescript",
    "react-components",
    "pixel-art-react",
    "retro-ui",
    "design-system",
    "icon-toolkit",
    "mit-license",
    "framework-agnostic",
    "vanilla-js",
    "headless",
    "pixel-icons"
  ],
  "author": {
    "name": "Joangel De La Rosa",
    "url": "https://github.com/joangeldelarosa"
  }
}
