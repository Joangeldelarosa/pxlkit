{
  "name": "@pxlkit/ui-kit-angular",
  "version": "2.2.0",
  "description": "Angular retro UI kit: the Pxlkit components as standalone, signal-based components with the same markup, theme and behaviour as the React kit",
  "license": "MIT",
  "type": "module",
  "module": "./dist/fesm2022/pxlkit-ui-kit-angular.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/pxlkit-ui-kit-angular.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "lint": "ngc -p tsconfig.lint.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "cd .storybook && ng run ui-kit-angular:storybook",
    "build-storybook": "cd .storybook && ng run ui-kit-angular:build-storybook"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0 <23.0.0",
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/forms": ">=20.0.0 <23.0.0"
  },
  "dependencies": {
    "@pxlkit/angular": "^0.1.0",
    "@pxlkit/gamification": "^1.2.5",
    "@pxlkit/ui-kit-core": "^2.2.0",
    "@tanstack/angular-table": "^8.21.4",
    "embla-carousel": "^8.6.0"
  },
  "devDependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-server": "~20.3.0",
    "@pxlkit/ui-kit": "*",
    "@types/jsdom": "^28.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "ng-packagr": "~20.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "~7.8.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2",
    "zone.js": "~0.15.0"
  },
  "keywords": [
    "pxlkit",
    "angular",
    "angular-components",
    "standalone-components",
    "signals",
    "ui-kit",
    "component-library",
    "design-system",
    "tailwind-css",
    "pixel-art",
    "retro",
    "8bit",
    "dark-mode",
    "accessible-ui",
    "typescript",
    "mit-license"
  ],
  "homepage": "https://pxlkit.xyz",
  "repository": "https://github.com/Joangeldelarosa/pxlkit",
  "author": {
    "name": "Joangel De La Rosa",
    "url": "https://github.com/joangeldelarosa"
  }
}
