{
  "name": "@pxlkit/voxel",
  "version": "0.1.5",
  "description": "MIT 3D voxel toolkit for React: pxlToVoxels and upscaleGrid turn Pxlkit pixel-art icons into voxel data for Three.js and React Three Fiber. Early preview.",
  "author": {
    "name": "Joangel De La Rosa",
    "url": "https://github.com/joangeldelarosa"
  },
  "license": "MIT",
  "homepage": "https://pxlkit.xyz/explore",
  "bugs": {
    "url": "https://github.com/Joangeldelarosa/pxlkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joangeldelarosa/pxlkit.git",
    "directory": "packages/voxel"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@pxlkit/core": "^1.4.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "pixel-art",
    "voxel",
    "voxels",
    "voxel-art",
    "pixel-to-voxel",
    "3d",
    "react-three-fiber",
    "r3f",
    "three-js",
    "threejs",
    "react-3d",
    "retro",
    "pxlkit"
  ]
}
