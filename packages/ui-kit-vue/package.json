{
  "name": "@pxlkit/ui-kit-vue",
  "version": "2.2.0",
  "description": "Retro pixel-art UI kit for Vue 3: the 111 components of the Pxlkit React kit, with the same markup, theme and behaviour. TypeScript, Tailwind CSS v4.",
  "license": "MIT",
  "homepage": "https://pxlkit.xyz/ui-kit#vue",
  "bugs": {
    "url": "https://github.com/Joangeldelarosa/pxlkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joangeldelarosa/pxlkit.git",
    "directory": "packages/ui-kit-vue"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@pxlkit/gamification": "^1.2.5",
    "@pxlkit/ui-kit-core": "^2.2.0",
    "@pxlkit/vue": "^0.1.0",
    "@tanstack/vue-table": "^8.21.3",
    "embla-carousel": "^8.6.0",
    "vee-validate": "^4.15.1"
  },
  "devDependencies": {
    "@pxlkit/ui-kit": "*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "~2.4.6",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.2",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "keywords": [
    "pxlkit",
    "vue",
    "vue3",
    "vue-components",
    "nuxt",
    "ui-kit",
    "component-library",
    "design-system",
    "tailwind-css",
    "pixel-art",
    "retro",
    "8bit",
    "dark-mode",
    "accessible-ui",
    "typescript",
    "vue-ui-kit",
    "vue-component-library",
    "ui-components",
    "retro-ui",
    "tailwindcss"
  ],
  "author": {
    "name": "Joangel De La Rosa",
    "url": "https://github.com/joangeldelarosa"
  }
}
