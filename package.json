{
  "name": "pxlkit-monorepo",
  "private": true,
  "version": "1.0.2",
  "author": {
    "name": "Joangel De La Rosa",
    "url": "https://github.com/joangeldelarosa"
  },
  "description": "Source-available retro toolkit for React, Vue and Angular — MIT-licensed rendering engine, UI kit and voxel packages, 226+ pixel art SVG icons under a commercial-friendly asset license, 111 React UI components, 3D parallax effects, animated icons, visual builder, toast notifications, and procedural voxel worlds powered by Three.js & React Three Fiber",
  "repository": "https://github.com/Joangeldelarosa/pxlkit",
  "homepage": "https://pxlkit.xyz",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "pxlkit",
    "pixel-art",
    "react",
    "vue",
    "angular",
    "ui-kit",
    "icons",
    "svg",
    "retro",
    "voxel-engine",
    "game-engine",
    "procedural-generation",
    "three-js",
    "react-three-fiber",
    "typescript",
    "tailwind-css",
    "source-available"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && npm run lint:scripts",
    "lint:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "clean": "turbo clean",
    "test": "turbo test && npm run test:scripts",
    "test:scripts": "vitest run --root scripts/audit-coherence && vitest run --root scripts/build-docs && vitest run --root scripts/parity",
    "test:coverage": "turbo test:coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:vue": "npm run storybook --workspace=@pxlkit/ui-kit-vue",
    "build-storybook:vue": "npm run build-storybook --workspace=@pxlkit/ui-kit-vue",
    "storybook:angular": "npm run storybook --workspace=@pxlkit/ui-kit-angular",
    "build-storybook:angular": "npm run build-storybook --workspace=@pxlkit/ui-kit-angular",
    "docs:build": "npm run docs:build --workspace=@pxlkit/ui-kit",
    "release:bump-plugin": "node scripts/release/bump-plugin.mjs",
    "audit": "npm run audit:coherence --workspace=@pxlkit/ui-kit",
    "audit:focus": "tsx scripts/focus-audit/run.ts"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.37",
    "@angular-devkit/build-angular": "~20.3.0",
    "@angular-devkit/core": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "storybook": "^10.6.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  }
}
